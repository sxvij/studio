[Unit]
Description=Studio Cloudflare Access check for nginx (127.0.0.1:8121)
After=network-online.target
Wants=network-online.target
[Service]
Environment=GATE_PORT=8121
EnvironmentFile=/etc/studio/gate.env
ExecStart=/usr/bin/python3 /opt/studio/gate/access_gate.py
DynamicUser=yes
Restart=always
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=96M
[Install]
WantedBy=multi-user.target
